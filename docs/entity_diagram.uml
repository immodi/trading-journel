@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false

title Trading Journal — Entity Diagram (implemented)

entity "User" as User {
  * Id : int
  --
  Username : string
  Email : string
  PasswordHash : string
  CreatedAt : datetime
}

entity "Trade" as Trade {
  * Id : int
  --
  UserId : int (FK)
  --
  Instrument : string(20)
  Direction : Direction
  Quantity : int
  EntryPrice : decimal(18,4)
  ExitPrice : decimal(18,4)
  EntryTime : datetime
  ExitTime : datetime
  Commission : decimal(18,4)
  ProfitLoss : decimal(18,4)
  CreatedAt : datetime
  UpdatedAt : datetime
}

enum "Direction" as Direction {
  Long = 0
  Short = 1
  Sideways = 2
}

User "1" ||--o{ "0..*" Trade : owns
Trade ..> Direction : stored as int

legend right
  == Storage ==
  SQLite via EF Core 10
  Single migration: InitialCreate

  == Rules ==
  Username and Email are unique.
  Commission defaults to 1.82 x Quantity when not supplied.
  ProfitLoss = (Exit - Entry) x Quantity - Commission
  (Entry - Exit for Short).
  Deleting a user cascades to their trades.

  == Not yet modelled ==
  TradeNote, Screenshot, Tag, TradeTag and
  ImportHistory are planned (see the roadmap).
endlegend

@enduml
