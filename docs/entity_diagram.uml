@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false

title Trading Journal — Entity Diagram (implemented)

entity "User" as User {
  * Id : int
  --
  Username : string
  Email : string
  PasswordHash : string
  CreatedAt : datetime
}

entity "Market" as Market {
  * Id : int
  --
  UserId : int (FK)
  --
  Name : string(100)
  Currency : string(3)
  CreatedAt : datetime
  UpdatedAt : datetime
}

entity "Trade" as Trade {
  * Id : int
  --
  UserId : int (FK)
  MarketId : int (FK)
  --
  Instrument : string(20)
  Direction : Direction
  Quantity : int
  PointValue : decimal(18,4)
  EntryPrice : decimal(18,4)
  ExitPrice : decimal(18,4)
  EntryTime : datetime
  ExitTime : datetime
  CommissionPerUnit : decimal(18,4)
  Commission : decimal(18,4)
  ProfitLoss : decimal(18,4)
  CreatedAt : datetime
  UpdatedAt : datetime
}

enum "Direction" as Direction {
  Long = 0
  Short = 1
  Sideways = 2
}

User "1" ||--o{ "0..*" Market : owns
User "1" ||--o{ "0..*" Trade : owns
Market "1" ||--o{ "0..*" Trade : groups
Trade ..> Direction : stored as int

legend right
  == Storage ==
  SQLite via EF Core 10
  Migrations: InitialCreate, AddMarketsAndCommissionPerUnit,
  AddPointValue

  == Rules ==
  Username and Email are unique.
  Market names are unique per user.
  Currency is a 3-letter ISO 4217 code.
  A trade always belongs to a market and
  inherits its currency.
  PointValue and CommissionPerSide are user
  supplied on create, edit, and import
  (CommissionPerSide per side of the round trip).
  CommissionPerUnit = CommissionPerSide x 2
  Commission = CommissionPerUnit x Quantity
  ProfitLoss = (Exit - Entry) x Quantity x PointValue
  - Commission (Entry - Exit for Short).
  Deleting a user cascades to their markets and trades.
  Deleting a market with trades is refused (409).

  == Not yet modelled ==
  TradeNote, Screenshot, Tag, TradeTag and
  ImportHistory are planned (see the roadmap).
endlegend

@enduml
