@Api_HostAddress = http://localhost:5067
@token = paste-a-jwt-from-the-login-response-here

### Register a new account
POST {{Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "demo",
  "email": "demo@example.com",
  "password": "Passw0rd!123"
}

### Log in
POST {{Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@example.com",
  "password": "Passw0rd!123"
}

### Current user
GET {{Api_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}

### List markets
GET {{Api_HostAddress}}/api/market
Authorization: Bearer {{token}}

### Create a market
POST {{Api_HostAddress}}/api/market
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "US Equities",
  "currency": "USD"
}

### Update a market
PUT {{Api_HostAddress}}/api/market/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currency": "EUR"
}

### Delete a market (409 when it still has trades)
DELETE {{Api_HostAddress}}/api/market/1
Authorization: Bearer {{token}}

### List trades
GET {{Api_HostAddress}}/api/trade
Authorization: Bearer {{token}}

### Create a trade
POST {{Api_HostAddress}}/api/trade
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "instrument": "MNQ",
  "direction": 0,
  "entryPrice": 18000,
  "exitPrice": 18025,
  "quantity": 2,
  "entryTime": "2026-05-01T13:30:00Z",
  "exitTime": "2026-05-01T14:05:00Z",
  "marketId": 1,
  "commissionPerUnit": 1.82
}

### Import trades into a market
POST {{Api_HostAddress}}/api/trade/import
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "marketId": 1,
  "trades": [
    {
      "instrument": "MNQ",
      "direction": 0,
      "quantity": 1,
      "entryPrice": 14824.98,
      "exitPrice": 14844.98,
      "entryTime": "2021-07-11T22:00:00Z",
      "exitTime": "2021-07-11T22:05:00Z",
      "commissionPerSide": 1
    }
  ]
}

### Delete a trade
DELETE {{Api_HostAddress}}/api/trade/1
Authorization: Bearer {{token}}

###
